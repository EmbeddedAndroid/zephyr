/dts-v1/;
#include <qcom/sail-monaco.dtsi>

/ {
	compatible = "arduino,ventuno-q-sail";
	model = "Arduino VENTUNO Q safety island";

	chosen {
		zephyr,sram = &sram0;
	};
};

&sail_mbox_rx {
	status = "okay";
};
