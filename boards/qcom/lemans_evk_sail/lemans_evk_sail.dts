/dts-v1/;
#include <qcom/sail-lemans.dtsi>

/ {
	compatible = "qcom,lemans-evk-sail";
	model = "Qualcomm Lemans EVK safety island";

	chosen {
		zephyr,sram = &sram0;
	};
};

&sail_mbox_rx {
	status = "okay";
};
