config SOC_SERIES_SAIL
	select ARM
	select CPU_CORTEX_R52
	select CPU_HAS_ARM_MPU
	select CPU_HAS_MPU
	select GIC_SINGLE_SECURITY_STATE
	select SOC_EARLY_INIT_HOOK if !SAIL_SECONDARY_CLUSTER

config SOC_SAIL_LEMANS
	help
	  Qualcomm Lemans safety island with Cortex-R52 processors.

config SOC_SAIL_MONACO
	help
	  Qualcomm Monaco safety island with Cortex-R52 processors.

config SAIL_ENTRY_ADDRESS
	hex
	depends on SOC_SERIES_SAIL
	default $(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_SRAM))
	help
	  Image entry vector, at the start of the image SRAM. The boot ROM and
	  the core release both start cores here.

config SAIL_START_WITHOUT_PCINIT
	bool "Start applications with PCInit deferred"
	depends on SOC_SERIES_SAIL
	select EXPERIMENTAL
	help
	  The cold initialization sequence stops before the power sequencer
	  programs are installed (PCInit), which is not implemented. Select
	  this to start applications at that point; sail_boot_mode_get() then
	  returns SAIL_BOOT_PCINIT_DEFERRED. Without it, and after any other
	  initialization failure, the boot stops before applications start.

config SAIL_MD_RECEIVE
	bool "Main-domain message queue"
	depends on SOC_SERIES_SAIL && MBOX
	help
	  Queue the messages the main domain sends through the SAIL receive
	  mailbox so that a thread can handle them. The application starts
	  reception and must be the only user of both channels. The mailbox
	  callback and the API serialize on a spinlock in the receiver.

config SAIL_RESET_SERVICE
	bool "Main-domain reset coordinator"
	depends on SAIL_START_WITHOUT_PCINIT && SAIL_MD_RECEIVE
	depends on MBOX_QCOM_SAIL_RX && !USERSPACE
	depends on !SMP || SCHED_CPU_MASK
	select EXPERIMENTAL
	help
	  Answer the main domain's reset (SOC_HR) and shutdown notices. For a
	  reset, prepare the reset controls and the PMIC, wait 50 ms and send
	  the answer word. For a shutdown the PMIC is prepared for power-off
	  instead, without the delay. The application starts the coordinator,
	  polls it from one thread and supplies a callback that retires its
	  own resources first. Under SMP that thread must be pinned to CPU 0
	  before it starts. On a board without a SAIL PMIC both notices are
	  answered at once, after clearing any armed reset debug enables;
	  the main domain's PS_HOLD then acts through the main PMIC.

config SAIL_SECONDARY_CLUSTER
	bool "Image for processor cluster 1"
	depends on SOC_SERIES_SAIL && SMP
	help
	  Build an image for cluster 1, which has its own interrupt controller
	  and runs next to the cluster-0 image. It has no cold initialization
	  and no main-domain services. The cluster-0 image starts its first
	  core; it starts its second core when the fuses allow it.

config SAIL_SECONDARY_CLUSTER_ENTRY
	hex "Cluster-1 image entry address"
	depends on SOC_SERIES_SAIL && SMP && !SAIL_SECONDARY_CLUSTER
	default 0x0
	help
	  Entry of the cluster-1 image loaded with this image. When not zero
	  and an entry vector is found there, the kernel starts cluster 1 at
	  this address after the cold initialization. Zero leaves cluster 1
	  in reset.

