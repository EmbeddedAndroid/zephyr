config SOC_SAIL_MONACO
	select ARM
	select CPU_CORTEX_R52
	select CPU_HAS_ARM_MPU
	select CPU_HAS_MPU
	select GIC_SINGLE_SECURITY_STATE
	select SOC_EARLY_INIT_HOOK
	help
	  Qualcomm Monaco safety island with Cortex-R52 processors.

config SAIL_PLL_FUSE_TRIM
	bool
	default y if SOC_SAIL_MONACO
	help
	  The SoC fuses carry SAIL PLL5 and PLL6 trim values, which the cold
	  initialization applies on top of the PLL defaults. Without it the
	  defaults are programmed and no fuse row is read.

config SAIL_CPU_PLL1_BOOT_L
	int
	default 83
	help
	  L value of the CPU PLL (PLL1) as the boot ROM leaves it running.
	  The cold initialization accepts a running PLL1 only at this value.
	  When it differs from 83, the early clocks move PLL1 to L = 83
	  (1593.6 MHz) after the CPU clock domain is configured.

config SAIL_I2C_PMIC
	bool
	default y if SOC_SAIL_MONACO
	help
	  SAIL is supplied by its own PMIC on the SAIL I2C bus (VENTUNO Q).
	  The cold initialization identifies the board, captures the HBCU
	  results and sets up that PMIC after the main-domain BIST. Without
	  it the cold initialization ends after the main-domain BIST.

config SAIL_START_WITHOUT_PCINIT
	bool "Start applications with PCInit deferred"
	depends on SOC_SAIL_MONACO
	select EXPERIMENTAL
	help
	  The cold initialization sequence stops before the power sequencer
	  programs are installed (PCInit), which is not implemented. Select
	  this to start applications at that point; sail_boot_mode_get() then
	  returns SAIL_BOOT_PCINIT_DEFERRED. Without it, and after any other
	  initialization failure, the boot stops before applications start.

config SAIL_MD_RECEIVE
	bool "Main-domain message queue"
	depends on SOC_SAIL_MONACO && MBOX && !SMP
	help
	  Queue the messages the main domain sends through the SAIL receive
	  mailbox so that a thread can handle them. The application starts
	  reception and must be the only user of both channels. The queue
	  uses irq_lock() for exclusion, so it needs a single CPU.

config SAIL_RESET_SERVICE
	bool "Main-domain reset coordinator"
	depends on SAIL_START_WITHOUT_PCINIT && SAIL_MD_RECEIVE
	depends on MBOX_QCOM_SAIL_RX && !USERSPACE
	select EXPERIMENTAL
	help
	  Answer the main domain's reset (SOC_HR) and shutdown notices. For a
	  reset, prepare the reset controls and the PMIC, wait 50 ms and send
	  the answer word. For a shutdown the PMIC is prepared for power-off
	  instead, without the delay. The application starts the coordinator,
	  polls it from one thread and supplies a callback that retires its
	  own resources first.
