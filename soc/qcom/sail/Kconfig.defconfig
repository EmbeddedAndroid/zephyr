if SOC_SERIES_SAIL

config NUM_IRQS
	default 1020

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 19200000

config KERNEL_ENTRY
	default "sail_reset"

configdefault ARM_MPU
	default y

# Cold initialization runs on the SYS stack before the main thread starts.
configdefault ARMV7_SYS_STACK_SIZE
	default 8192

# Cache enablement on SAIL is not supported yet; the port runs with caches off.
configdefault DCACHE
	default n

configdefault ICACHE
	default n

# Single-core images run without a system timer; multi-core images use the
# per-core generic timer.
configdefault SYS_CLOCK_EXISTS
	default n if !SMP

# Secondary cores are released through pm_cpu_on() in the SoC code.
configdefault PM_CPU_OPS
	default y if SMP

endif
