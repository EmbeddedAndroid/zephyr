config SOC_SERIES_SAIL
	bool

config SOC_SAIL_MONACO
	bool
	select SOC_SERIES_SAIL
	select SOC_FAMILY_QUALCOMM

config SOC_SERIES
	default "sail" if SOC_SERIES_SAIL

config SOC
	default "sail_monaco" if SOC_SAIL_MONACO
