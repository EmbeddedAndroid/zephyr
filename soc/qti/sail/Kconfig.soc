# SPDX-License-Identifier: Apache-2.0

config SOC_SERIES_SAIL
	bool

config SOC_SAIL_R52
	bool
	select SOC_SERIES_SAIL
	select SOC_FAMILY_QTI
	select ARM
	select CPU_CORTEX_R52
	select CPU_HAS_ARM_MPU

config SOC_SERIES
	default "sail" if SOC_SERIES_SAIL

config SOC
	default "sail_r52" if SOC_SAIL_R52
