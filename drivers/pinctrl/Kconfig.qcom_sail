config PINCTRL_QCOM_SAIL_TLMM
	bool "Qualcomm SAIL TLMM pin controller driver"
	default y
	depends on DT_HAS_QCOM_SAIL_TLMM_ENABLED
	help
	  Enable the pin controller driver for the Qualcomm safety island
	  (SAIL) TLMM.
